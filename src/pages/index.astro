---
import Layout from "@/layouts/_Layout.astro"
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Hero from '@/components/Hero.astro';
import WhyChooseUs from '@/components/WhyChooseUs.astro';
import FinalCta from '@/components/FinalCta.astro';
import Gallery from '@/components/Gallery.astro';
import FeaturedProducts from '@/components/preact/FeaturedProducts';
import { loadAllProducts } from '@/lib/products';

const products = await loadAllProducts({ withVIP: false });
const featuredProducts = products.filter(p => p.featured);
---

<Layout>
  <Header withSearch={false} />
  <main id="main-content">
    <Hero />
    <FeaturedProducts products={featuredProducts} client:load />
    <WhyChooseUs />
    <Gallery />
    <FinalCta />
  </main>
  <Footer />
</Layout>