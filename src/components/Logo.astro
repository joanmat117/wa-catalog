---
import { resolveUrlFrom,APP_NAME,LOGO_URL } from '@/utils/helpers';
import BaseLink from './preact/BaseLink';
import BaseImg from './preact/BaseImg';

const pn = Astro.url.pathname;
const brandName = APP_NAME
---

<BaseLink
  href={resolveUrlFrom(pn, '/')}
  class="flex items-center gap-2 shrink-0"
>
    <img
      src={LOGO_URL}
      alt={brandName}
      class="h-8"
    />
  <span class="font-display font-bold text-xl text-gray-800 sm:block">
    {brandName}
  </span>
</BaseLink>
