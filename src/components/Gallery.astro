---
import { GALLERY_IMAGES } from '@/utils/helpers';
---

<section class="py-16 bg-gray-50" id="galeria">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="font-display font-bold text-2xl sm:text-3xl text-gray-800 text-center mb-12">Galería de Trabajos Realizados</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {GALLERY_IMAGES.map((img, i) => (
        <div class="relative aspect-square overflow-hidden rounded-2xl shadow-lg group">
          <img
            src={img}
            alt={`Instalación solar ${i + 1}`}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>