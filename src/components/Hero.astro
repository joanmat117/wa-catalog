---
import { BANNER_TITLE, BANNER_CONTENT, HERO_IMAGE_URL, WHATSAPP_LINK, resolveUrlFrom } from '@/utils/helpers';
import BaseLink from '@/components/preact/BaseLink';

const currentPath = Astro.url.pathname;
---

<section class="relative min-h-[60vh] flex items-center justify-center bg-cover bg-center bg-no-repeat" style={`background-image: url(${HERO_IMAGE_URL})`}>
  <div class="absolute inset-0 bg-gradient-to-r from-primary-900/80 via-primary-800/70 to-primary-900/80" />
  <div class="relative z-10 max-w-5xl mx-auto px-4 py-16 text-center text-white">
    <h1 class="font-display font-extrabold font-display uppercase text-3xl sm:text-4xl lg:text-5xl mb-4">{BANNER_TITLE}</h1>
    <p class="text-white/90 text-base sm:text-lg max-w-2xl mx-auto mb-8">{BANNER_CONTENT}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <BaseLink
        href={resolveUrlFrom(currentPath, '/products')}
        class="bg-white text-primary-600 font-bold py-3 px-8 rounded-xl hover:bg-gray-100 transition shadow-lg touch-target"
      >
        Ver Kits Solares
      </BaseLink>
      <BaseLink
        href={WHATSAPP_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-white/10 text-white font-semibold py-3 px-8 rounded-xl hover:bg-white/20 transition border border-white/30 backdrop-blur-sm touch-target"
      >
        Contactar por WhatsApp
      </BaseLink>
    </div>
  </div>
</section>
