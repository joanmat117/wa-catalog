---
import { APP_NAME } from '@/utils/helpers';
import IconSolarPower from '~icons/mdi/solar-power';
import IconShield from '~icons/mdi/shield-check';
import IconWrench from '~icons/mdi/wrench';
import IconBattery from '~icons/mdi/battery-heart';

const features = [
  { Icon: IconSolarPower, title: 'Kits Completos', desc: 'Paneles + Inversor + Batería + Instalación' },
  { Icon: IconShield, title: 'Garantía 5-10 Años', desc: 'Equipos certificados con respaldo total' },
  { Icon: IconWrench, title: 'Instalación Certificada', desc: 'Técnicos especializados, trabajo limpio' },
  { Icon: IconBattery, title: 'Autonomía Total', desc: 'Energía 24/7 aunque falle la red' },
];
---

<section class="py-16 bg-primary-900 text-white">
  <div class="max-w-7xl mx-auto px-4">
    <h2 class="font-display font-bold text-2xl sm:text-3xl text-white text-center mb-12">¿Por qué elegir {APP_NAME}?</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map(({ Icon, title, desc }) => (
        <div class="bg-white/5 backdrop-blur-sm border border-white/10 p-6 rounded-2xl hover:bg-white/10 transition text-center">
          <div class="text-primary-200 mb-4 inline-flex"><Icon class="size-10" aria-hidden="true" /></div>
          <h3 class="font-semibold text-white mb-2">{title}</h3>
          <p class="text-white/70 text-sm">{desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>